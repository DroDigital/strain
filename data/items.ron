uniques: [
  (id: "last_word", name: "Last Word", base: "combat_knife", mythic: false, fx: [BackstabCrit(2.0), Execute(0.15)],
   desc: "Backstabs always crit. Enemies under 15% health die to any hit.", flavor: "Issued to the men who close the gates."),
  (id: "curfew", name: "Curfew", base: "nightstick", mythic: false, fx: [HitSlow(2.5), ComboFinisher(1.8)],
   desc: "Hits slow. The last blow of a chain hits far harder.", flavor: "Nine o'clock. Everyone inside."),
  (id: "butchers_bill", name: "The Butcher's Bill", base: "butcher_cleaver", mythic: false, fx: [KillHeal(12), KillFrenzy(30)],
   desc: "Kills heal you and quicken your arm.", flavor: "Paid weekly, in advance."),
  (id: "tuning_fork", name: "Tuning Fork", base: "lead_pipe", mythic: false, fx: [HitChain(0.5)],
   desc: "Every hit rings through two more bodies nearby.", flavor: "It hums when they are close."),
  (id: "exit_wound", name: "Exit Wound", base: "fire_axe", mythic: false, fx: [HeavyPull(7), HeavyShock(40)],
   desc: "Heavy attacks drag enemies in, then throw them back.", flavor: "BREAK GLASS."),
  (id: "demolition_order", name: "Demolition Order", base: "sledgehammer", mythic: false, fx: [HeavyShock(75), Stat(AtkSpeed, -10)],
   desc: "Charged heavy attacks crack the street. Slower swings.", flavor: "Condemned, like everything else here."),
  (id: "glass_riot", name: "Glass Riot", base: "riot_shield", mythic: false, fx: [BlockReflect, BlockThorns(18)],
   desc: "Blocking returns projectiles and hurts whoever hit you.", flavor: "The crowd was already inside it."),
  (id: "marrow_saint", name: "Marrow Saint", base: "bone_blade", mythic: false, fx: [Stat(Lifesteal, 4), NoHeal],
   desc: "Hits feed you. You can no longer use heal charges.", flavor: "It was a rib, once. Somebody's."),
  (id: "umbilical", name: "Umbilical", base: "tendril_whip", mythic: false, fx: [HitRot(8), ParryTendril(8)],
   desc: "Hits rot. A perfect block grows a second, hungry tendril.", flavor: "Still attached to something."),
  (id: "second_heart", name: "Second Heart", base: "flesh_node", mythic: false, fx: [SpellBlood, Stat(SpellPower, 15)],
   desc: "Spells cost health instead of Strain.", flavor: "It beats out of time with yours."),
  (id: "wrong_angle", name: "Wrong Angle", base: "rift_shard", mythic: false, fx: [SpellEcho(0.35)],
   desc: "Spells have a 35% chance to happen twice.", flavor: "Measure it again. It has changed."),
  (id: "pilot_light", name: "Pilot Light", base: "cinder_coal", mythic: false, fx: [FireHeart, DodgeFire(16)],
   desc: "Cinder heals you instead of burning. Dodging leaves fire.", flavor: "Never quite went out."),
  (id: "quiet_mask", name: "Quiet Mask", base: "gas_mask", mythic: false, fx: [StrainCalm, Stat(StrainCap, -20)],
   desc: "High Strain causes no afflictions. Less room for it.", flavor: "You can't hear it singing in here."),
  (id: "crowd_control", name: "Crowd Control", base: "riot_helmet", mythic: false, fx: [SprintCharge(30), Stat(Armor, 6)],
   desc: "Sprinting into enemies batters them aside.", flavor: "Visor cracked from the inside."),
  (id: "hi_vis", name: "Hi-Vis", base: "work_coveralls", mythic: false, fx: [Dread, Stat(MoveSpeed, 6)],
   desc: "Carriers hesitate before attacking you.", flavor: "They remember being told to stop."),
  (id: "deserters_vest", name: "Deserter's Vest", base: "flak_vest", mythic: false, fx: [SecondWind, Stat(Armor, 8)],
   desc: "Once per life, a killing blow leaves you standing.", flavor: "Name tape cut away."),
  (id: "runners_debt", name: "Runner's Debt", base: "jeans", mythic: false, fx: [DodgeCostsHp, Stat(MoveSpeed, 12)],
   desc: "Dodging costs health instead of stamina.", flavor: "Keep running. It adds up."),
  (id: "first_greaves", name: "Greaves of the First", base: "sinew_greaves", mythic: false, fx: [DoubleDodge, TimeReflex(1.2)],
   desc: "Longer, cheaper dodges. Dodging through a blow slows time.", flavor: "Grown, not made."),
  (id: "dead_mans_tags", name: "Dead Man's Tags", base: "dog_tags", mythic: false, fx: [KillStamina],
   desc: "Kills refill your stamina.", flavor: "Two tags. Nobody took the second."),
  (id: "promise", name: "Promise", base: "wedding_ring", mythic: false, fx: [Stat(HealCharges, 2), HealStrain(15)],
   desc: "Two more heal charges. Healing also vents Strain.", flavor: "It no longer comes off."),
  (id: "hunger_stone", name: "Hunger Stone", base: "tooth_necklace", mythic: false, fx: [Glutton(4), Stat(Biomass, 25)],
   desc: "Biomass heals you as you absorb it.", flavor: "None of the teeth match."),
  (id: "pressure_vial", name: "Pressure Vial", base: "spore_vial", mythic: false, fx: [SporeAura(7), HealBurst(40)],
   desc: "You leak spores. Healing bursts them outward.", flavor: "Do not shake."),
  (id: "pyre_ash", name: "Pyre Ash", base: "lucky_coin", mythic: false, fx: [PitHunger, Stat(Luck, 40)],
   desc: "Resting advances every infection by a stage. Far better loot.", flavor: "Heads, they get worse."),
  (id: "two_fisted", name: "Two-Fisted Gospel", base: "radio_bead", mythic: false, fx: [TwoHandOne],
   desc: "Two-handed weapons can be held in one hand.", flavor: "Static, and a voice saying: more."),
  (id: "impact", name: "Impact", base: "meteor_chip", mythic: true, fx: [AlwaysFullPower, Stat(StrainCap, -30)],
   desc: "Every spell is cast at full-Strain power. Far less capacity.", flavor: "Still warm."),
  (id: "patient_zeros_hand", name: "Patient Zero's Hand", base: "bone_blade", mythic: true, fx: [Spellblade, StrainPower(0.6)],
   desc: "Every third melee hit casts your selected spell for free. Melee scales with Strain.", flavor: "It was reaching for you."),
  (id: "long_night", name: "The Long Night", base: "breaching_axe", mythic: true, fx: [HeavyFreeAtStrain, MeleeStrain(3), StrainLeak(5)],
   desc: "Melee hits ADD Strain; Strain bleeds away on its own. Heavy attacks are free above half Strain.", flavor: "Nobody was relieved at dawn."),
  (id: "cordon", name: "Cordon", base: "riot_shield", mythic: true, fx: [Stat(ParryWindow, 100), Stat(BlockPower, -100), ParryNova(40)],
   desc: "Parry window doubled and parries detonate. Ordinary blocks stop nothing.", flavor: "The line holds, or it doesn't."),
  (id: "open_door", name: "Open Door", base: "rift_edge", mythic: true, fx: [DodgeBlink, Phase],
   desc: "Your dodge is a blink that passes through bodies.", flavor: "It was never closed."),
  (id: "mothers_coal", name: "Mother's Coal", base: "cinder_coal", mythic: true, fx: [SprintFire(22), HitBurn(10), FireHeart],
   desc: "You burn as you run, your hits ignite, and fire mends you.", flavor: "She kept them warm."),
  (id: "geometers_lens", name: "Geometer's Lens", base: "eye_in_amber", mythic: true, fx: [Eyes, SpellFree(0.25), Stat(SpellPower, 20)],
   desc: "See what hides. A quarter of your spells add no Strain.", flavor: "It solves you as you look."),
  (id: "digestors_knot", name: "Digestor's Knot", base: "carapace", mythic: true, fx: [Regen(2.5), HurtLarvae(0.35)],
   desc: "You knit constantly. Wounds birth larvae that fight for you.", flavor: "Still digesting."),
  (id: "cantors_tongue", name: "Cantor's Tongue", base: "halo_fragment", mythic: true, fx: [ParryNova(60), RuptureStrain(30)],
   desc: "Perfect blocks scream. Ruptures vent Strain.", flavor: "It knows one note."),
  (id: "the_seed", name: "The Seed", base: "meteor_chip", mythic: true, fx: [Stat(HpPct, -50), Stat(Dmg, 100)],
   desc: "Half health. Double damage.", flavor: "It only ever wanted soil."),
],
)
