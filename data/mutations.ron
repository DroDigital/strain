// Mutation table. `vis` is the growth every mutation adds to the player model.
[
  (id: "spore_glands", name: "Spore Glands", tier: 1, desc: "Dodging leaves a cloud of rotting spores.", fx: [DodgeSpores(10)], vis: (Sacs, Back, Growth), tag: Some("spore"), syn: Some(("fire", DodgeFire(8)))),
  (id: "hooked_marrow", name: "Hooked Marrow", tier: 1, desc: "Heavy attacks drag nearby enemies toward you.", fx: [HeavyPull(5)], vis: (Spikes, ArmR, Bone), tag: Some("bone")),
  (id: "reflex_tendril", name: "Reflex Tendril", tier: 1, desc: "A perfect block grows a tendril that lashes on its own for a while.", fx: [ParryTendril(6)], vis: (Fronds, ShoulderL, Flesh), tag: Some("tendril")),
  (id: "ember_sweat", name: "Ember Sweat", tier: 1, desc: "Dodging leaves a patch of fire.", fx: [DodgeFire(10)], vis: (Cracks, Legs, Ember), tag: Some("fire")),
  (id: "static_skin", name: "Static Skin", tier: 1, desc: "Dodging releases a shock that staggers what is close.", fx: [DodgeShock(12)], vis: (Halo, Hip, RiftGlow), tag: Some("rift")),
  (id: "carrion_appetite", name: "Carrion Appetite", tier: 1, desc: "Kills heal you.", fx: [KillHeal(6)], vis: (Mandibles, Head, Bone), tag: Some("blood"), syn: Some(("blood", KillHeal(4)))),
  (id: "adrenal_bloom", name: "Adrenal Bloom", tier: 1, desc: "Kills quicken your attacks for five seconds.", fx: [KillFrenzy(20)], vis: (Sacs, Chest, Vein)),
  (id: "bone_spurs", name: "Bone Spurs", tier: 1, desc: "Whatever strikes your guard is cut by it.", fx: [BlockThorns(10)], vis: (Spikes, ArmL, Bone), tag: Some("bone")),
  (id: "rot_touch", name: "Rot Touch", tier: 1, desc: "Your hits leave rot that keeps eating.", fx: [HitRot(5)], vis: (Tumor, ArmR, Growth), tag: Some("spore"), syn: Some(("spore", HitRot(4)))),
  (id: "hot_blood", name: "Hot Blood", tier: 1, desc: "Your hits ignite. You burn easier too.", fx: [HitBurn(5), Stat(FireRes, -20)], vis: (Cracks, ArmR, Ember), tag: Some("fire")),
  (id: "web_spit", name: "Web Spit", tier: 1, desc: "Your hits slow their victims.", fx: [HitSlow(1.5)], vis: (Fronds, ArmL, Flesh), tag: Some("tendril")),
  (id: "thick_hide", name: "Thick Hide", tier: 1, desc: "Tough hide. Dodging is more tiring.", fx: [Stat(Armor, 8), Stat(DodgeCost, 15)], vis: (Plates, Chest, Chitin)),
  (id: "second_stomach", name: "Second Stomach", tier: 1, desc: "Absorbed biomass heals you a little.", fx: [Glutton(2)], vis: (Tumor, Hip, Flesh), tag: Some("blood")),
  (id: "magnet_marrow", name: "Magnet Marrow", tier: 1, desc: "Loot and biomass drift toward you.", fx: [Magnet], vis: (Halo, Chest, Metal)),
  (id: "extra_eyes", name: "Extra Eyes", tier: 1, desc: "Mimics and ambushers are revealed. Lock on from further away.", fx: [Eyes], vis: (Eyes, Head, GrowthGlow), tag: Some("eye"), syn: Some(("eye", Stat(Crit, 10)))),
  (id: "lung_sacs", name: "Lung Sacs", tier: 1, desc: "More stamina. A little less of you to hit.", fx: [Stat(MaxStam, 25), Stat(MaxHp, -10)], vis: (Sacs, Back, Skin)),
  (id: "dense_muscle", name: "Dense Muscle", tier: 1, desc: "Heavy attacks hit harder. Everything is a little slower.", fx: [Stat(HeavyDmg, 25), Stat(AtkSpeed, -5)], vis: (Tumor, ShoulderR, Skin)),
  (id: "twitch_fibres", name: "Twitch Fibres", tier: 1, desc: "Faster attacks. Less stamina.", fx: [Stat(AtkSpeed, 10), Stat(MaxStam, -10)], vis: (Fins, ArmR, Vein)),
  (id: "knitting_flesh", name: "Knitting Flesh", tier: 1, desc: "You slowly regenerate.", fx: [Regen(0.8)], vis: (Glow, Chest, Vein), tag: Some("blood")),
  (id: "vent_gills", name: "Vent Gills", tier: 1, desc: "Melee hits vent more Strain.", fx: [Stat(StrainDrain, 30)], vis: (Fins, Head, Flesh)),
  (id: "swollen_cortex", name: "Swollen Cortex", tier: 1, desc: "More room for Strain. Less for you.", fx: [Stat(StrainCap, 25), Stat(MaxHp, -10)], vis: (Tumor, Head, Vein)),
  (id: "predator_gait", name: "Predator Gait", tier: 1, desc: "You move faster.", fx: [Stat(MoveSpeed, 10)], vis: (Fins, Legs, Chitin)),
  (id: "keratin_knuckles", name: "Keratin Knuckles", tier: 1, desc: "The last hit of a light chain hits half again as hard.", fx: [ComboFinisher(1.5)], vis: (Plates, ArmR, Bone), tag: Some("bone")),
  (id: "scavenger_gut", name: "Scavenger Gut", tier: 1, desc: "More biomass and better finds.", fx: [Stat(Biomass, 20), Stat(Luck, 10)], vis: (Mandibles, Head, Chitin)),
  (id: "nerve_lattice", name: "Nerve Lattice", tier: 1, desc: "A wider perfect-block window.", fx: [Stat(ParryWindow, 30)], vis: (Glow, ArmL, RiftGlow), tag: Some("rift"), syn: Some(("rift", ParryStrain(10)))),
  (id: "clot_factor", name: "Clot Factor", tier: 1, desc: "Healing is stronger.", fx: [Stat(HealPower, 30)], vis: (Sacs, Hip, Vein), tag: Some("blood")),
  (id: "marrow_shards", name: "Marrow Shards", tier: 1, desc: "Light attacks fling a shard of bone.", fx: [HitShard(8)], vis: (Spikes, ShoulderR, Bone), tag: Some("bone"), syn: Some(("bone", HitShard(6)))),
  (id: "fever", name: "Fever", tier: 1, desc: "Near death you hit much harder.", fx: [LowHpPower(30)], vis: (Cracks, Chest, Ember)),
  (id: "sprinters_heart", name: "Sprinter's Heart", tier: 1, desc: "Sprinting into enemies batters them.", fx: [SprintCharge(14)], vis: (Tumor, Chest, Flesh)),
  (id: "feral_sense", name: "Feral Sense", tier: 1, desc: "Strikes from behind always crit.", fx: [BackstabCrit(1.6)], vis: (Eyes, Back, GrowthGlow), tag: Some("eye")),
  (id: "blade_arm", name: "Blade Arm", tier: 2, desc: "Your right hand becomes a bone blade. It can hold nothing else this life.", fx: [HandWeapon(0, "mut_blade")], vis: (Spikes, ArmR, Bone), tag: Some("bone")),
  (id: "whip_arm", name: "Whip Arm", tier: 2, desc: "Your left hand unravels into a tendril whip. It can hold nothing else this life.", fx: [HandWeapon(1, "mut_whip")], vis: (Fronds, ArmL, Flesh), tag: Some("tendril")),
  (id: "club_arm", name: "Club Arm", tier: 2, desc: "Your right hand swells into a club of bone. Heavy attacks hit harder.", fx: [HandWeapon(0, "mut_club"), Stat(HeavyDmg, 20)], vis: (Tumor, ArmR, Bone), tag: Some("bone")),
  (id: "flesh_organ", name: "Budding Palm", tier: 2, desc: "Your left hand becomes a Flesh casting organ. It can hold nothing else.", fx: [HandOrgan(1, Flesh)], vis: (Sacs, ArmL, Vein), tag: Some("spore")),
  (id: "rift_organ", name: "Folded Palm", tier: 2, desc: "Your left hand becomes a Rift casting organ. It can hold nothing else.", fx: [HandOrgan(1, Rift)], vis: (Halo, ArmL, RiftGlow), tag: Some("rift")),
  (id: "cinder_organ", name: "Coal Palm", tier: 2, desc: "Your left hand becomes a Cinder casting organ. It can hold nothing else.", fx: [HandOrgan(1, Cinder)], vis: (Cracks, ArmL, Ember), tag: Some("fire")),
  (id: "third_arm", name: "Third Arm", tier: 2, desc: "A third arm strikes on its own at whatever is close.", fx: [ExtraArm(16)], vis: (Arm, Back, Flesh), tag: Some("tendril"), syn: Some(("tendril", ExtraArm(10)))),
  (id: "corpse_bloom", name: "Corpse Bloom", tier: 2, desc: "What you kill bursts.", fx: [KillExplode(30)], vis: (Sacs, ShoulderL, GrowthGlow), tag: Some("spore"), syn: Some(("fire", KillExplode(25)))),
  (id: "chain_nerves", name: "Chain Nerves", tier: 2, desc: "Hits arc to two more bodies nearby.", fx: [HitChain(0.35)], vis: (Fronds, ArmR, Vein), tag: Some("tendril")),
  (id: "spore_shroud", name: "Spore Shroud", tier: 2, desc: "You leak spores constantly. You heal poorly.", fx: [SporeAura(5), Stat(HealPower, -25)], vis: (Sacs, Chest, Growth), tag: Some("spore")),
  (id: "ossified_fist", name: "Ossified Fist", tier: 2, desc: "Fully charged heavy attacks send out a shockwave.", fx: [HeavyShock(35)], vis: (Plates, ArmR, Bone), tag: Some("bone"), syn: Some(("bone", HeavyShock(20)))),
  (id: "spine_eruption", name: "Spine Eruption", tier: 2, desc: "Heavy attacks raise a line of bone spikes.", fx: [HeavySpikes(28)], vis: (Spikes, Back, Bone), tag: Some("bone")),
  (id: "screaming_parry", name: "Screaming Parry", tier: 2, desc: "A perfect block bursts outward.", fx: [ParryNova(35)], vis: (Mandibles, Head, Flesh)),
  (id: "cool_parry", name: "Grounding", tier: 2, desc: "A perfect block vents Strain.", fx: [ParryStrain(15)], vis: (Glow, ArmL, RiftGlow), tag: Some("rift")),
  (id: "brood_pouch", name: "Brood Pouch", tier: 2, desc: "Being wounded can birth a larva that fights for you.", fx: [HurtLarvae(0.25)], vis: (Sacs, Hip, Flesh), tag: Some("brood"), syn: Some(("spore", HurtLarvae(0.15)))),
  (id: "blast_cysts", name: "Blast Cysts", tier: 2, desc: "Heavy blows against you detonate a cyst.", fx: [HurtBurst(30)], vis: (Sacs, Back, Ember), tag: Some("fire")),
  (id: "mending_burst", name: "Mending Burst", tier: 2, desc: "Healing bursts spores outward.", fx: [HealBurst(35)], vis: (Glow, Chest, GrowthGlow), tag: Some("spore")),
  (id: "slow_clot", name: "Slow Clot", tier: 2, desc: "Healing is slower but half again as strong.", fx: [HealRegen], vis: (Tumor, Chest, Vein), tag: Some("blood")),
  (id: "purge_gland", name: "Purge Gland", tier: 2, desc: "Healing also vents Strain.", fx: [HealStrain(20)], vis: (Sacs, Head, Vein)),
  (id: "burning_stride", name: "Burning Stride", tier: 2, desc: "Sprinting leaves a trail of fire.", fx: [SprintFire(12)], vis: (Cracks, Legs, Ember), tag: Some("fire")),
  (id: "hollow_bones", name: "Hollow Bones", tier: 2, desc: "Longer, cheaper dodges. You break easier.", fx: [DoubleDodge, Stat(Armor, -6)], vis: (Fins, Legs, Bone), excl: Some("legs")),
  (id: "calcified_legs", name: "Calcified Legs", tier: 2, desc: "You cannot sprint. You barely flinch.", fx: [NoSprint, Stat(Armor, 18), Stat(Poise, 25)], vis: (Plates, Legs, Bone), excl: Some("legs"), tag: Some("bone")),
  (id: "glass_skin", name: "Glass Skin", tier: 2, desc: "A quarter less health. Far more damage.", fx: [Stat(HpPct, -25), Stat(Dmg, 30)], vis: (Cracks, Chest, Glass), excl: Some("skin")),
  (id: "carapace", name: "Carapace", tier: 2, desc: "Heavy plating. You are slower.", fx: [Stat(Armor, 20), Stat(MoveSpeed, -8)], vis: (Plates, Back, Chitin), excl: Some("skin")),
  (id: "overclocked", name: "Overclocked", tier: 2, desc: "Melee damage rises with Strain.", fx: [StrainPower(0.4)], vis: (Glow, Head, RiftGlow), tag: Some("rift"), syn: Some(("rift", StrainPower(0.2)))),
  (id: "opportunist", name: "Opportunist", tier: 2, desc: "Enemies under a tenth of their health die to any hit.", fx: [Execute(0.1)], vis: (Mandibles, Head, Chitin)),
  (id: "hemophage", name: "Hemophage", tier: 3, desc: "You can no longer use heal charges. You feed instead.", fx: [NoHeal, Stat(Lifesteal, 3), KillHeal(8)], vis: (Mandibles, Head, Vein), excl: Some("heal"), tag: Some("blood")),
  (id: "fat_reserves", name: "Fat Reserves", tier: 3, desc: "Two more heal charges. You are slower.", fx: [Stat(HealCharges, 2), Stat(MoveSpeed, -6)], vis: (Tumor, Hip, Skin), excl: Some("heal")),
  (id: "blood_magic", name: "Blood Magic", tier: 3, desc: "Spells cost health instead of Strain.", fx: [SpellBlood], vis: (Cracks, Chest, Vein), excl: Some("magic"), tag: Some("blood")),
  (id: "quiet_mind", name: "Quiet Mind", tier: 3, desc: "High Strain no longer afflicts you. Weaker spells.", fx: [StrainCalm, Stat(SpellPower, -15)], vis: (Eyes, Head, Skin), excl: Some("magic"), tag: Some("eye")),
  (id: "echo_chamber", name: "Echo Chamber", tier: 3, desc: "Spells sometimes happen twice.", fx: [SpellEcho(0.25)], vis: (Halo, Head, RiftGlow), tag: Some("rift"), syn: Some(("eye", SpellEcho(0.1)))),
  (id: "phase_tissue", name: "Phase Tissue", tier: 3, desc: "Your dodge is a blink through bodies. It adds Strain.", fx: [Phase, DodgeBlink], vis: (Halo, Back, RiftGlow), tag: Some("rift")),
  (id: "no_guard", name: "No Guard", tier: 3, desc: "You cannot block. Why would you.", fx: [NoBlock, Stat(Dmg, 25), Stat(AtkSpeed, 10)], vis: (Spikes, ShoulderL, Bone), excl: Some("guard")),
  (id: "bulwark", name: "Bulwark", tier: 3, desc: "Stronger blocks that send projectiles back.", fx: [Stat(BlockPower, 25), BlockReflect], vis: (Plates, ArmL, Chitin), excl: Some("guard")),
  (id: "undying_knot", name: "Undying Knot", tier: 3, desc: "Once per life, a killing blow leaves you standing.", fx: [SecondWind], vis: (Tumor, Chest, Vein), tag: Some("blood")),
  (id: "time_reflex", name: "Time Reflex", tier: 3, desc: "Dodging through a blow slows the world for a moment.", fx: [TimeReflex(1.0)], vis: (Eyes, Head, RiftGlow), tag: Some("eye")),
  (id: "rupture_bloom", name: "Rupture Bloom", tier: 3, desc: "A Rupture detonates its victim.", fx: [RuptureNova(60)], vis: (Sacs, ArmR, GrowthGlow), tag: Some("spore")),
  (id: "rupture_feast", name: "Rupture Feast", tier: 3, desc: "A Rupture heals you.", fx: [RuptureHeal(30)], vis: (Mandibles, Chest, Flesh), tag: Some("blood")),
  (id: "fire_heart", name: "Fire Heart", tier: 3, desc: "Cinder mends you instead of burning you.", fx: [FireHeart], vis: (Cracks, Chest, Ember), tag: Some("fire")),
  (id: "volatile_marrow", name: "Volatile Marrow", tier: 3, desc: "Blows against you sometimes detonate. It hurts them more than you.", fx: [Unstable(40)], vis: (Sacs, Back, Ember), tag: Some("fire")),
  (id: "leaking_mind", name: "Leaking Mind", tier: 3, desc: "Strain bleeds away on its own. Less room for it.", fx: [StrainLeak(3), Stat(StrainCap, -15)], vis: (Fins, Head, Vein)),
  (id: "strain_plating", name: "Strain Plating", tier: 3, desc: "Armour rises with Strain.", fx: [StrainArmor(30)], vis: (Plates, Chest, RiftGlow), tag: Some("rift")),
  (id: "dread_pheromone", name: "Dread Pheromone", tier: 3, desc: "Carriers hesitate before attacking you.", fx: [Dread], vis: (Fins, Back, Growth), tag: Some("spore")),
  (id: "spellblade_nerves", name: "Spellblade Nerves", tier: 3, desc: "Every third melee hit casts your selected spell for free.", fx: [Spellblade], vis: (Glow, ArmR, RiftGlow), tag: Some("rift")),
  (id: "apex_frame", name: "Apex Frame", tier: 4, desc: "You are large now. Health and damage, at the cost of grace.", fx: [Stat(HpPct, 30), Stat(Dmg, 15), Stat(DodgeCost, 30), Stat(MoveSpeed, -6)], vis: (Antlers, Head, Bone)),
  (id: "full_bloom", name: "Full Bloom", tier: 4, desc: "Every spell is cast at full-Strain power. Far less capacity.", fx: [AlwaysFullPower, Stat(StrainCap, -25)], vis: (Antlers, Back, GrowthGlow), excl: Some("magic")),
  (id: "twin_blades", name: "Twin Blades", tier: 4, desc: "Both hands become bone blades. Neither can hold anything again.", fx: [HandWeapon(0, "mut_blade"), HandWeapon(1, "mut_blade"), Stat(AtkSpeed, 15)], vis: (Spikes, ArmL, Bone), tag: Some("bone")),
  (id: "hive_body", name: "Hive Body", tier: 4, desc: "Wounds birth larvae and your kills burst. You are less yourself.", fx: [HurtLarvae(0.5), KillExplode(40), Stat(HpPct, -15)], vis: (Sacs, Chest, Flesh), tag: Some("brood")),
  (id: "ripening", name: "The Ripening", tier: 4, desc: "Biomass feeds you richly. Resting advances every infection in the city.", fx: [Glutton(6), Stat(Biomass, 50), PitHunger], vis: (Tail, Hip, Flesh), tag: Some("blood")),
  (id: "event_horizon", name: "Event Horizon", tier: 4, desc: "Heavy attacks pull everything in and throw it back out.", fx: [HeavyPull(9), HeavyShock(60), Stat(AtkSpeed, -10)], vis: (Halo, ShoulderR, RiftGlow), tag: Some("rift")),
  (id: "pyre_walker", name: "Pyre Walker", tier: 4, desc: "You run and roll in fire, and it mends you.", fx: [SprintFire(25), DodgeFire(25), FireHeart], vis: (Cracks, Back, Ember), tag: Some("fire")),
  (id: "perfect_host", name: "Perfect Host", tier: 4, desc: "The virus stops fighting you.", fx: [Stat(StrainCap, 40), Stat(SpellPower, 25), Stat(StrainDrain, 30)], vis: (Antlers, Head, RiftGlow)),
  (id: "thousand_cuts", name: "Thousand Cuts", tier: 4, desc: "Much faster attacks that rot. Heavy attacks suffer.", fx: [Stat(AtkSpeed, 25), HitRot(8), Stat(HeavyDmg, -30)], vis: (Fins, ShoulderR, Vein)),
  (id: "colossus_marrow", name: "Colossus Marrow", tier: 4, desc: "Two-handed weapons fit in one hand.", fx: [TwoHandOne, Stat(Poise, 30)], vis: (Tumor, ShoulderL, Bone), tag: Some("bone")),
]
