// Spells. There is no mana: `strain` is added to the caster on every cast.
[
  // ---- Flesh
  (id: "bone_spikes", name: "Bone Spikes", school: Flesh, strain: 12, cast: 0.45, kind: Spikes(34, 9),
   desc: "A row of bone erupts from the ground ahead."),
  (id: "tendril_grab", name: "Tendril Grab", school: Flesh, strain: 10, cast: 0.35, kind: Grab(14, 14),
   desc: "Lash a tendril out and drag a victim to you, staggered."),
  (id: "spore_cloud", name: "Spore Cloud", school: Flesh, strain: 14, cast: 0.5, kind: Cloud(4.5, 14, 7),
   desc: "Exhale a lingering cloud that rots everything inside."),
  (id: "life_drain", name: "Life Drain", school: Flesh, strain: 16, cast: 0.6, kind: Drain(10, 40, 0.5),
   desc: "Tear vitality from a target and take half of it."),
  (id: "brood", name: "Brood", school: Flesh, strain: 20, cast: 0.8, kind: Brood(3, 18),
   desc: "Birth three larvae that fight for you until they burst."),
  (id: "carapace", name: "Carapace", school: Flesh, strain: 15, cast: 0.5, kind: Carapace(45, 12),
   desc: "Plates of bone harden over you. Armour and poise for a while."),
  // ---- Rift
  (id: "blink", name: "Blink", school: Rift, strain: 8, cast: 0.12, kind: Blink(8),
   desc: "Step through folded space in the direction you move."),
  (id: "gravity_well", name: "Gravity Well", school: Rift, strain: 16, cast: 0.5, kind: Well(7, 9, 6, 4),
   desc: "A point of impossible weight drags enemies together."),
  (id: "spatial_tear", name: "Spatial Tear", school: Rift, strain: 18, cast: 0.55, kind: Tear(38, 11, 4),
   desc: "Cut a wound in the air. Anything crossing it is shredded."),
  (id: "stasis_field", name: "Stasis Field", school: Rift, strain: 20, cast: 0.6, kind: Stasis(6.5, 6),
   desc: "Time thickens inside the field. Everything but you slows."),
  (id: "transpose", name: "Transpose", school: Rift, strain: 9, cast: 0.2, kind: Transpose(18, 16),
   desc: "Swap places with your target. It arrives off balance."),
  (id: "shard_volley", name: "Shard Volley", school: Rift, strain: 13, cast: 0.4, kind: Bolt(22, 13, 0, 5, 26, true),
   desc: "Five seeking slivers of somewhere else."),
  // ---- Cinder (strong against all infected, burns the caster slightly)
  (id: "ember_bolt", name: "Ember Bolt", school: Cinder, strain: 9, cast: 0.3, kind: Bolt(26, 30, 2.2, 1, 0, false),
   desc: "A fast bolt of fire that bursts on impact."),
  (id: "immolate", name: "Immolate", school: Cinder, strain: 17, cast: 0.5, kind: Nova(5.5, 46),
   desc: "Ignite the air around you."),
  (id: "fire_wall", name: "Fire Wall", school: Cinder, strain: 16, cast: 0.5, kind: Wall(10, 26, 7),
   desc: "Draw a burning line across the street."),
  (id: "kindle", name: "Kindle", school: Cinder, strain: 12, cast: 0.5, kind: Kindle(12, 20),
   desc: "Your weapons burn. Every hit sets the target alight."),
  (id: "falling_star", name: "Falling Star", school: Cinder, strain: 24, cast: 0.7, kind: Meteor(5, 95, 1.3),
   desc: "Call down a fragment of the thing that started this."),
  (id: "ash_breath", name: "Ash Breath", school: Cinder, strain: 14, cast: 0.35, kind: Breath(7, 34, 1.6),
   desc: "Breathe a cone of fire."),
]
